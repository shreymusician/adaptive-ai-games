{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "lib": ["ES2019"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "./vendor-dist",
    "rootDir": "../upstream/packages",
    "paths": {
      "@tosios/common": ["../upstream/packages/common/src"]
    },
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "../upstream/packages/common/src/**/*.ts",
    "../upstream/packages/server/src/entities/**/*.ts",
    "../upstream/packages/server/src/states/**/*.ts",
    "../upstream/packages/server/src/rooms/**/*.ts"
  ]
}
