MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/adaptive-games?retryWrites=true&w=majority
MONGODB_DB_NAME=adaptive-games

# Same MongoDB database platform/api uses (see platform/api/.env.example) —
# both services connect to it concurrently by design. Copy the exact same
# MONGODB_URI value used there.

# Milestone 1c — must be the EXACT SAME value as platform/api's
# EVENT_PIPELINE_MATCH_TOKEN_SECRET (platform/api/.env.example). Match-token
# verification is HMAC-SHA256 (symmetric): the live TOSIOS server verifies
# tokens platform/api minted, so both services must share this secret.
EVENT_PIPELINE_MATCH_TOKEN_SECRET=replace-with-a-different-long-random-string
