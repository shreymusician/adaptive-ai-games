{
  "name": "adaptive-ai-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Adaptive AI Gaming Platform — monorepo root",
  "workspaces": [
    "platform/api",
    "platform/web",
    "platform/sdk/*",
    "platform/event-pipeline",
    "platform/player-intelligence",
    "platform/ai-engine/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
